# Copy to .env and fill in. Never commit .env.

# Model provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna         # cheapest; or gpt-6.1-sol (balanced), gpt-6-astra (most capable)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Where mail comes from: "mailpit" (local test server), "folder", or "imap"
MAIL_SOURCE=mailpit
MAILPIT_API_URL=http://localhost:8025
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# Who the replies come from
COMPANY_NAME=Acme Home Goods
AGENT_SIGNATURE=The Acme Home Goods Support Team
SUPPORT_ADDRESS=support@acmehomegoods.example

# Your grounding data (replace the samples)
POLICIES_PATH=data/policies.md
ORDERS_PATH=data/orders.json

# Auto-send rules
AUTO_SEND=true          # false = draft everything, send nothing
MIN_CONFIDENCE=0.8      # drafts below this go to review
MAX_AUTO_REFUND=100     # refund requests above this go to review

# Real mailbox (only for: python -m email_agent run --source imap)
# Gmail: imap.gmail.com / smtp.gmail.com, and use an App Password, not your login password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_REVIEW_FOLDER=Needs-Review
SMTP_HOST=
SMTP_PORT=587
# SMTP_USER / SMTP_PASSWORD default to the IMAP values
